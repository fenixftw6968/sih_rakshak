{
  "manifest_version": 3,
  "name": "Rakshak - Privacy Vision Agent",
  "version": "1.1.0",
  "description": "Privacy-preserving browser vision agent with in-page floating overlay that redacts sensitive data locally before AI reasoning.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Rakshak Privacy Agent (Toggle In-Page Overlay)"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/pii_detector.js",
        "content/context_collector.js",
        "content/visual_redactor.js",
        "content/action_executor.js",
        "content/overlay_agent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
